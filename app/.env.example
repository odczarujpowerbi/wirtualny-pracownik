# SZABLON dostepow. bootstrap_init_secrets.py kopiuje ten plik do
# secrets/.env (ktory jest w .gitignore). Uzupelnij wartosci w secrets/.env,
# NIE tutaj — tu nie trzymamy prawdziwych sekretow.
#
# Wypelnij te, ktore realnie podlaczasz. Rejestracja w config/integrations.yaml
# != gotowy konektor. Szablony MCP (secrets/mcp/*.json) tworzy ten sam skrypt.

# ============================================================
# GLOWNY MODEL AI
# ============================================================
# Anthropic: glowna petla agenta loguje sie w TERMINALU przez Claude Code
# (`claude login`, subskrypcja/OAuth) - NIE wymaga klucza.
# Ten klucz API jest do bezposrednich wywolan SDK 'anthropic' w skryptach
# (validator_visual.py, ad_copy_generator.py, mailerlite_report_analyzer.py oraz
# wlasne skrypty). Wpisz, gdy bedziesz go potrzebowal.
ANTHROPIC_API_KEY=
#
# OpenRouter - fallback modeli (README stack, PLAN-WDROZENIA.md sekcja 19).
# OPENROUTER_API_KEY=

# ============================================================
# PROJECTLY (MCP)
# ============================================================
# PROJECTLY_API_KEY: osobisty token Bearer 'prj_...' z Projectly.
# PROJECTLY_BASE_URL: endpoint MCP (nizej domyslny produkcyjny).
PROJECTLY_API_KEY=
PROJECTLY_BASE_URL=https://projectly-production.up.railway.app/api/mcp

# ============================================================
# LOKALNY MODEL (Ollama) - computer use / walidacja promptow
# ============================================================
# Instalowany przez bootstrap_install_local_model.ps1. To konfiguracja, nie
# sekret. Model wizyjny "steruje ekranem" (krok 4 hierarchii: computer use);
# model tekstowy to druga opinia w validator_prompt.py.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VISION_MODEL=llama3.2-vision
# OLLAMA_TEXT_MODEL=hermes3

# ============================================================
# CRM / SPRZEDAZ (MCP)
# ============================================================
# Zoho CRM (MCP) - analogicznie do Projectly: token Bearer + endpoint MCP.
# ZOHO_CRM_MCP_TOKEN=
# ZOHO_CRM_MCP_URL=
# zanfia.com (MCP) - platforma sprzedazy kursow.
# ZANFIA_MCP_TOKEN=
# ZANFIA_MCP_URL=

# ============================================================
# MICROSOFT 365 / GRAPH (mail, SharePoint, OneDrive)
# ============================================================
# Wymaga rejestracji aplikacji w Azure AD (Microsoft Entra) + pakiet 'msal'.
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_MAILBOX=

# ============================================================
# GOOGLE WORKSPACE (Docs/Sheets/Search Console/Analytics)
# ============================================================
# Konto serwisowe Google Cloud - sciezka do pliku JSON z kluczem
# (google_workspace_client.py). Plik JSON wrzuc do app/secrets/ (w .gitignore).
# GOOGLE_APPLICATION_CREDENTIALS=C:\AIWorker\wirtualny-pracownik\app\secrets\google_service_account.json
# Opcjonalnie: impersonacja uzytkownika Workspace (delegacja domenowa) - gdy
# agent ma dzialac na Drive/Sheets konkretnej osoby, nie tylko na zasobach
# udostepnionych kontu serwisowemu.
# GOOGLE_DELEGATED_USER=user@twojafirma.pl

# ============================================================
# REKLAMA
# ============================================================
# Meta Ads (Facebook/Instagram) - ad_set_launcher.py, ad_performance_analyzer.py.
# Kolejnosc setupu: 1) aplikacja typu Business powiazana z BM; 2) System User +
# assety + token z uprawnieniem ads_management; 3) zebrac ponizsze 4 ID; 4) test
# flow w Graph API Explorer na jednej kampanii testowej ze statusem PAUSED;
# 5) dopiero potem SDK facebook-business (Python) i kod na Railway.
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=            # token System Usera (ads_read do odczytu, ads_management do sterowania)
# META_AD_ACCOUNT_ID=           # format act_XXXXXXXXXX
# META_API_VERSION=v21.0        # opcjonalnie; domyslnie v21.0 (meta_ads_client.py)
# TikTok Ads - drugi kanal reklamowy.
# TIKTOK_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ADVERTISER_ID=

# ============================================================
# NEWSLETTER
# ============================================================
# MailerLite - mailerlite_client.py (REST API).
# MAILERLITE_API_KEY=

# ============================================================
# GITHUB (repo, pull requesty)
# ============================================================
# Token z uprawnieniem repo - push/PR agenta.
# GITHUB_TOKEN=

# ============================================================
# MIRO (OAuth: client id + secret)
# ============================================================
# MIRO_CLIENT_ID=
# MIRO_CLIENT_SECRET=

# ============================================================
# inFAKT (ksiegowosc - dedykowane konto bota)
# ============================================================
# INFAKT_API_KEY=

# ============================================================
# KOSZTY
# ============================================================
# Nadpisuje domyslny dzienny limit (cost_tracker.py).
# DAILY_COST_LIMIT_USD=20.0
