# Skopiuj do .env (nigdy nie commituj prawdziwego .env — jest w .gitignore)
# i wypełnij prawdziwymi wartościami z lokalnego magazynu sekretów.

# Runner (PLAN-WDROZENIA.md sekcja 19) — API, nie subskrypcja interaktywna.
ANTHROPIC_API_KEY=

# Projectly (MCP) — bez tego runner działa w trybie mock (projectly_client.py).
# PROJECTLY_API_KEY: osobisty token Bearer 'prj_...' z Projectly (rola z
#   dostępem do projektów, do których ma sięgać bot).
# PROJECTLY_BASE_URL: endpoint MCP, np. https://projectly-production.up.railway.app/api/mcp
# Reguły biznesowe (rola->konto AI, aliasy osób, zakres) w config/projectly.yaml.
PROJECTLY_API_KEY=
PROJECTLY_BASE_URL=

# Opcjonalnie: nadpisuje domyślny dzienny limit kosztu (cost_tracker.py).
# DAILY_COST_LIMIT_USD=20.0

# Poczta (email_client.py) — bez WSZYSTKICH czterech runner działa w trybie
# mock (draft zapisywany do runs/mock_outbox/, nic nie wysyła naprawdę).
# Wymaga rejestracji aplikacji w Azure AD (Microsoft Entra) i pakietu 'msal'
# (patrz requirements.txt — jeszcze odkomentowany dopiero po realnym podłączeniu).
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_MAILBOX=
